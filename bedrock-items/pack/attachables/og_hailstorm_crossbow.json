{
 "format_version": "1.10.0",
 "minecraft:attachable": {
  "description": {
   "identifier": "orangegames:hailstorm_crossbow",
   "materials": {
    "default": "entity_alphatest",
    "enchanted": "entity_alphatest_glint"
   },
   "textures": {
    "default": "textures/attachables/og/hailstorm_crossbow",
    "enchanted": "textures/misc/enchanted_actor_glint",
    "crossbow_pulling_0": "textures/attachables/og/hailstorm_crossbow_pulling_0",
    "crossbow_pulling_1": "textures/attachables/og/hailstorm_crossbow_pulling_1",
    "crossbow_pulling_2": "textures/attachables/og/hailstorm_crossbow_pulling_2",
    "crossbow_arrow": "textures/attachables/og/hailstorm_crossbow_arrow",
    "crossbow_rocket": "textures/attachables/og/hailstorm_crossbow_firework"
   },
   "geometry": {
    "default": "geometry.og.hailstorm_crossbow",
    "crossbow_pulling_0": "geometry.og.hailstorm_crossbow_pulling_0",
    "crossbow_pulling_1": "geometry.og.hailstorm_crossbow_pulling_1",
    "crossbow_pulling_2": "geometry.og.hailstorm_crossbow_pulling_2",
    "crossbow_arrow": "geometry.og.hailstorm_crossbow_arrow",
    "crossbow_rocket": "geometry.og.hailstorm_crossbow_firework"
   },
   "animations": {
    "third_person_main_hand": "animation.og.hailstorm_crossbow.third_person_main_hand",
    "third_person_off_hand": "animation.og.hailstorm_crossbow.third_person_off_hand",
    "first_person_main_hand": "animation.og.hailstorm_crossbow.first_person_main_hand",
    "first_person_off_hand": "animation.og.hailstorm_crossbow.first_person_off_hand",
    "head": "animation.og.hailstorm_crossbow.head"
   },
   "scripts": {
    "pre_animation": [
     "v.main_hand = c.item_slot == 'main_hand';",
     "v.off_hand = c.item_slot == 'off_hand';",
     "v.head = c.item_slot == 'head';"
    ],
    "animate": [
     {
      "third_person_main_hand": "v.main_hand && !c.is_first_person"
     },
     {
      "third_person_off_hand": "v.off_hand && !c.is_first_person"
     },
     {
      "first_person_main_hand": "v.main_hand && c.is_first_person"
     },
     {
      "first_person_off_hand": "v.off_hand && c.is_first_person"
     },
     {
      "head": "v.head"
     }
    ]
   },
   "render_controllers": [
    "controller.render.og.hailstorm"
   ]
  }
 }
}